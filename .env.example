NODE_ENV=development

# Database
PORT=3000
DB_HOST=
DB_USER=root
DB_PASS=
DB_NAME=ceramic_ml_db
JWT_SECRET=-

# MongoDB
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB_NAME=cerascan
MONGO_USER=
MONGO_PASSWORD=

# Service URLs
MICROSERVICES_URL=http://127.0.0.1:8000
PYTHON_ML_GRPC_URL=127.0.0.1:50051
FRONTEND_URL=http://localhost:5173

# Redis
REDIS_URL=redis://localhost:6379

# Resend
RESEND_API_KEY=-

# Midtrans
MIDTRANS_SERVER_KEY=your_midtrans_server_key
MIDTRANS_CLIENT_KEY=your_midtrans_client_key

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Kafka
KAFKA_CLIENT_ID=ceramic-scan-app
KAFKA_BROKERS=localhost:9092

# Cloudflare R2
R2_ACCESS_KEY_ID=-
R2_SECRET_ACCESS_KEY=-
R2_TOKEN_VALUE=-
R2_SPECIFIC_ENDPOINT=https://-.r2.cloudflarestorage.com
